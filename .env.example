# Database
DATABASE_URL="postgresql://vc:vc@localhost:5432/vc?schema=public"

POSTGRES_DB=vc
POSTGRES_USER=vc
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD

# Memory limits
POSTGRES_MEM_LIMIT=512m
BACKEND_MEM_LIMIT=768m
FRONTEND_MEM_LIMIT=512m
NGINX_MEM_LIMIT=256m
BACKUP_MEM_LIMIT=256m
FAIL2BAN_MEM_LIMIT=256m
SSH_MEM_LIMIT=128m
JENKINS_MEM_LIMIT=1024m
N8N_MEM_LIMIT=512m

# Backup
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_SECONDS=86400

# n8n
N8N_WEBHOOK_URL=http://n8n:5678/webhook/virtualclass-ai
N8N_ENCRYPTION_KEY=YOUR_SECRET_ENCRYPTION_KEY
N8N_API_KEY=YOUR_N8N_API_KEY
N8N_EDITOR_BASE_URL=http://localhost:5678

# OpenRouter (used by n8n)
OPENAI_API_KEY=sk-or-v1-YOUR_OPENROUTER_API_KEY

# Telegram Bot
TELEGRAM_BOT_TOKEN=          # получить у @BotFather
TELEGRAM_CHAT_ID=            # ID чата для уведомлений 
SERVER_IP=                   # публичный IP сервера для ссылок на Grafana

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123

# Monitoring memory limits
PROMETHEUS_MEM_LIMIT=512m
NODE_EXPORTER_MEM_LIMIT=128m
POSTGRES_EXPORTER_MEM_LIMIT=128m
GRAFANA_MEM_LIMIT=256m
ALERTMANAGER_MEM_LIMIT=128m
TELEGRAM_BOT_MEM_LIMIT=256m

# SSH
SSH_USER=vcadmin
SSH_PUID=1000
SSH_PGID=1000

# CORS
FRONTEND_URL=

TZ=Asia/Almaty
